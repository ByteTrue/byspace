# Optional advanced local dictation overrides.
# Prefer installing and selecting a model from Host Settings > Dictation.
BYSPACE_LOCAL_MODELS_DIR=
BYSPACE_DICTATION_LOCAL_STT_MODEL=

# Server Configuration
# Location for runtime state (agents.json, etc.). Defaults to ~/.byspace
BYSPACE_HOME=~/.byspace

# Listen address. Defaults to 127.0.0.1:6777
# Can be host:port, /path/to/socket, or unix:///path/to/socket
BYSPACE_LISTEN=127.0.0.1:6777

# Debug recordings (dictation input only)
# When enabled, recordings are saved under `${cwd}/.debug/recordings/`
BYSPACE_DICTATION_DEBUG=1

# Enable verbose Claude SDK stream logging (trace-level per-token logs)
BYSPACE_CLAUDE_DEBUG=1
