{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{js,mjs,cjs,ts}"],
      "project": ["scripts/**/*.{js,mjs,cjs,ts}"]
    },
    "packages/app": {
      "entry": [
        "index.ts",
        "app.config.js",
        "babel.config.js",
        "app/**/*.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "src/**/*.e2e.{ts,tsx}",
        "src/**/*.native.{ts,tsx}",
        "e2e/**/*.{ts,tsx}",
        "playwright.config.{ts,js}",
        "vitest.config.{ts,js}",
        "test-stubs/**/*.ts"
      ],
      "project": ["**/*.{ts,tsx,js,jsx}"],
      "paths": {
        "@server/*": ["../server/src/*"]
      },
      "ignore": ["dist/**", ".expo/**"]
    },
    "packages/relay": {
      "entry": ["src/index.ts", "src/e2ee.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/highlight": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "sherpa-onnx-node",
    "@playwright/test",
    "material-icon-theme",
    "eas-cli",
    "wait-on",
    "concurrently",
    "get-port-cli",
    "patch-package",
    "cross-env",
    "expo-module-scripts",
    "buffer",
    "metro-config"
  ],
  "ignoreBinaries": [
    "expo-module",
    "xed",
    "eas",
    "playwright",
    "wrangler",
    "powershell",
    "tsx",
    "vitest",
    "open"
  ]
}
