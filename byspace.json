{
  "worktree": {
    "setup": [
      "npm ci",
      "node ./scripts/seed-worktree-dev-state.mjs",
      "node ./scripts/dev-daemon.mjs --build-only"
    ]
  },
  "scripts": {
    "daemon": {
      "type": "service",
      "command": "node ./scripts/dev-daemon.mjs"
    },
    "app": {
      "type": "service",
      "command": "node ./scripts/dev-web.mjs"
    },
    "desktop": {
      "type": "service",
      "command": "node ./scripts/dev-desktop.mjs"
    },
    "typecheck": {
      "command": "npm run typecheck"
    }
  }
}
