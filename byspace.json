{
  "worktree": {
    "setup": ["npm ci", "node ./scripts/seed-worktree-dev-state.mjs", "npm run build:server"]
  },
  "scripts": {
    "daemon": {
      "type": "service",
      "command": "node ./scripts/dev-daemon.mjs"
    },
    "app": {
      "type": "service",
      "command": "node ./scripts/dev-app.mjs"
    },
    "ios-simulator": {
      "type": "service",
      "command": "node ./scripts/byspace-ios-simulator-service.mjs"
    },
    "typecheck": {
      "command": "npm run typecheck"
    }
  }
}
