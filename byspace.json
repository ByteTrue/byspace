{
  "worktree": {
    "setup": [
      "npm ci",
      "node ./scripts/seed-ios-native-cache.mjs",
      "node ./scripts/seed-worktree-dev-state.mjs",
      "npm run build:server",
      "npm run build --workspace=@getpaseo/expo-two-way-audio"
    ]
  },
  "scripts": {
    "daemon": {
      "type": "service",
      "command": "PASEO_DEV_MANAGED_HOME=1 PASEO_DEV_ROOT=\"${BYSPACE_WORKTREE_PATH:-$PWD}\" BYSPACE_HOME=\"${BYSPACE_WORKTREE_PATH:-$PWD}/.dev/byspace-home\" PASEO_SKIP_DEV_SERVER_BUILD=1 BYSPACE_LISTEN=0.0.0.0:${BYSPACE_PORT:-6778} ./scripts/dev-daemon.sh"
    },
    "app": {
      "type": "service",
      "command": "PASEO_DEV_MANAGED_HOME=1 PASEO_DEV_ROOT=\"${BYSPACE_WORKTREE_PATH:-$PWD}\" BYSPACE_HOME=\"${BYSPACE_WORKTREE_PATH:-$PWD}/.dev/byspace-home\" BYSPACE_LISTEN=0.0.0.0:${BYSPACE_SERVICE_DAEMON_PORT:-6778} PASEO_DEV_DAEMON_ENDPOINT=localhost:${BYSPACE_SERVICE_DAEMON_PORT:-6778} EXPO_PORT=${BYSPACE_PORT:-} ./scripts/dev-app.sh"
    },
    "desktop": {
      "type": "service",
      "command": "PASEO_DEV_MANAGED_HOME=1 PASEO_DEV_ROOT=\"${BYSPACE_WORKTREE_PATH:-$PWD}\" BYSPACE_HOME=\"${BYSPACE_WORKTREE_PATH:-$PWD}/.dev/byspace-home\" BYSPACE_LISTEN=0.0.0.0:${BYSPACE_SERVICE_DAEMON_PORT:-6778} PASEO_DEV_DAEMON_ENDPOINT=localhost:${BYSPACE_SERVICE_DAEMON_PORT:-6778} EXPO_PORT=${BYSPACE_PORT:-} exec ./packages/desktop/scripts/dev.sh"
    },
    "ios-simulator": {
      "type": "service",
      "command": "PASEO_DEV_MANAGED_HOME=1 PASEO_DEV_ROOT=\"$PWD\" BYSPACE_HOME=\"$PWD/.dev/byspace-home\" BYSPACE_LISTEN=0.0.0.0:${BYSPACE_SERVICE_DAEMON_PORT} PASEO_DEV_DAEMON_ENDPOINT=localhost:${BYSPACE_SERVICE_DAEMON_PORT} ./scripts/byspace-ios-simulator-service.sh"
    },
    "typecheck": {
      "command": "npm run typecheck"
    }
  }
}
