{
  "name": "byspace",
  "version": "0.1.0",
  "private": true,
  "description": "Web and daemon workspace for byspace",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/highlight",
    "packages/plugin",
    "packages/protocol",
    "packages/client",
    "packages/app",
    "packages/relay"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall-patches.mjs",
    "build": "npm run build:web",
    "build:protocol": "npm run build --workspace=@byspace/protocol",
    "build:client": "npm run build --workspace=@byspace/client",
    "build:relay": "npm run build --workspace=@byspace/relay",
    "build:highlight": "npm run build --workspace=@byspace/highlight",
    "build:plugin": "npm run build --workspace=@byspace/plugin",
    "build:web-deps": "npm run build:client && npm run build:relay && npm run build:highlight && npm run build:plugin",
    "build:web": "npm run build:web --workspace=@byspace/app",
    "web": "npm run web --workspace=@byspace/app",
    "watch:protocol": "npm run watch --workspace=@byspace/protocol",
    "watch:client": "tsc -p packages/client/tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:browser": "npm run test:browser --workspace=@byspace/app",
    "test:e2e:go-daemon": "npm run build:web && npm run test:e2e:go-daemon --workspace=@byspace/app",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.6",
    "lightningcss": "1.30.1",
    "mermaid": "11.17.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3",
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "ws": "8.21.3"
  }
}
