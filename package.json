{
  "name": "byspace",
  "version": "0.21.0-beta.5",
  "private": true,
  "description": "BySpace: control local AI coding agents from anywhere",
  "keywords": [
    "development",
    "mcp",
    "openai",
    "voice",
    "voice-assistant"
  ],
  "homepage": "https://byspace.cc.cd",
  "license": "Apache-2.0",
  "author": {
    "name": "ByteTrue",
    "email": "bytetrue@outlook.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteTrue/byspace.git"
  },
  "workspaces": [
    "packages/highlight",
    "packages/protocol",
    "packages/client",
    "packages/app",
    "packages/relay",
    "workers/relay"
  ],
  "scripts": {
    "acp:version-drift": "node scripts/check-acp-catalog-version-drift.mjs",
    "acp:version-drift:check": "node scripts/check-acp-catalog-version-drift.mjs --fail-on-drift",
    "acp:version-drift:update": "node scripts/check-acp-catalog-version-drift.mjs --update",
    "audit": "node scripts/audit.mjs",
    "audit:browser": "node scripts/browser-conformance.mjs",
    "audit:emit": "node scripts/go-emit-parity.mjs",
    "audit:go-parity": "node scripts/go-parity-audit.mjs",
    "audit:ledger": "node scripts/reaudit-ledger-check.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:app-deps": "npm run build:highlight && npm run build:client",
    "build:app-deps:clean": "npm run build:highlight:clean && npm run build:client:clean",
    "build:client": "npm run build --workspace=@bytetrue/client",
    "build:client:clean": "npm run build:protocol:clean && npm run build:clean --workspace=@bytetrue/client",
    "build:daemon-web-ui": "node scripts/build-daemon-web-ui.mjs",
    "build:highlight": "npm run build --workspace=@bytetrue/highlight",
    "build:highlight:clean": "npm run build:clean --workspace=@bytetrue/highlight",
    "build:protocol": "npm run build --workspace=@bytetrue/protocol",
    "build:protocol:clean": "npm run build:clean --workspace=@bytetrue/protocol",
    "build:relay": "npm run build --workspace=@bytetrue/relay",
    "build:relay:clean": "npm run build:clean --workspace=@bytetrue/relay",
    "cli": "node ./scripts/dev-cli.mjs",
    "dev": "node ./scripts/dev-app.mjs",
    "dev:app": "node ./scripts/dev-app.mjs",
    "dev:daemon": "node ./scripts/dev-daemon.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:check:files": "oxfmt --check",
    "format:files": "oxfmt",
    "icons:generate": "node scripts/generate-icons.mjs",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "node scripts/postinstall-patches.mjs",
    "prepare": "lefthook install --force",
    "release:beta:major": "npm run release:check && npm run version:all:beta:major && npm run release:push",
    "release:beta:minor": "npm run release:check && npm run version:all:beta:minor && npm run release:push",
    "release:beta:next": "npm run release:check && npm run version:all:beta:next && npm run release:push",
    "release:beta:patch": "npm run release:check && npm run version:all:beta:patch && npm run release:push",
    "release:check": "go build ./... && go vet ./... && npm run build:daemon-web-ui && npm run release:pack:bytetrue",
    "release:major": "npm run release:check && npm run version:all:major && npm run release:push",
    "release:minor": "npm run release:check && npm run version:all:minor && npm run release:push",
    "release:pack:bytetrue": "node scripts/package-go-release.mjs . dist/npm",
    "release:patch": "npm run release:check && npm run version:all:patch && npm run release:push",
    "release:prepare": "npm install --workspaces --include-workspace-root",
    "release:promote": "npm run release:check && npm run version:all:promote && npm run release:push",
    "release:publish:beta:dry-run": "npm run release:pack:bytetrue && npm publish --dry-run dist/npm/bytetrue-byspace-$(node -p \"require('./package.json').version\").tgz --access public --tag beta",
    "release:publish:dry-run": "npm run release:pack:bytetrue && npm publish --dry-run dist/npm/bytetrue-byspace-$(node -p \"require('./package.json').version\").tgz --access public",
    "release:push": "node scripts/push-current-release-tag.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:go": "go test ./...",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "version": "npm run version:sync-internal && npm run release:prepare && git add -A",
    "version:all:beta:major": "node scripts/set-release-version.mjs --mode beta-major",
    "version:all:beta:minor": "node scripts/set-release-version.mjs --mode beta-minor",
    "version:all:beta:next": "node scripts/set-release-version.mjs --mode beta-next",
    "version:all:beta:patch": "node scripts/set-release-version.mjs --mode beta-patch",
    "version:all:major": "node scripts/set-release-version.mjs --mode major",
    "version:all:minor": "node scripts/set-release-version.mjs --mode minor",
    "version:all:patch": "node scripts/set-release-version.mjs --mode patch",
    "version:all:promote": "node scripts/set-release-version.mjs --mode promote",
    "version:sync-internal": "node scripts/sync-workspace-versions.mjs",
    "watch:client": "tsc -p packages/client/tsconfig.json --watch --preserveWatchOutput",
    "watch:protocol": "npm run watch --workspace=@bytetrue/protocol",
    "web": "npm run web --workspace=@bytetrue/app",
    "deploy:hosted": "npm run deploy --workspace=@bytetrue/relay",
    "deploy:relay-go": "npm run deploy --workspace=byspace-relay-go",
    "deploy:relay-go:beta": "npm run deploy:beta --workspace=byspace-relay-go"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "cross-spawn": "^7.0.6",
    "get-port-cli": "^3.0.0",
    "js-yaml": "^4.1.1",
    "knip": "^5.82.1",
    "lefthook": "^2.1.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "^0.22.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.56.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "ws": "^8.20.0"
  },
  "overrides": {
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.6",
    "lightningcss": "1.30.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3"
  }
}
