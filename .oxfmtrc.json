{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "*.lock",
    "**/*.gen.ts",
    "**/*.gen.tsx",
    "web/public/schemas/*.json",
    "bywork/**",
    "design/references/**",
    "design/sheet-assets/**",
    "design/component-sheet.html",
    "web/src/ui/**",
    "web/src/styles/shadcn-tailwind.css"
  ]
}
