{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byspace-relay-go",
  "main": "./build/worker.mjs",
  "compatibility_date": "2024-12-01",
  "build": {
    "command": "npm run build",
  },
  // Hibernation moved the cost from billed duration to volume: every accepted socket and every
  // frame that reaches the object is a Durable Object invocation, and Workers Logs writes one
  // event per invocation. At 1% the free plan's 200,000 events/day stops being a ceiling, and a
  // relay failure is still visible in the 1% that is kept.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
  },
  // One hostname per channel. `app.byspace.cc.cd` serves the PWA and `wss://app.byspace.cc.cd/ws`
  // from the same origin, which is what a pairing offer assumes; a separate `relay.` hostname was a
  // second route to the same Durable Object namespace and is retired.
  //
  // These were the TypeScript worker's until the Go worker proved itself: same scenario, one idle
  // connection held 180s, cost 0.06 GB-s here against 1.93 GB-s there. A Cloudflare custom domain
  // routes to exactly one Worker, so deploying this moves them, and rolling back means deploying
  // packages/relay again with its own routes.
  "routes": [{ "pattern": "app.byspace.cc.cd", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "RelayRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"],
    },
  ],
  // Serve the web export on the same origin as the relay, exactly like the
  // TypeScript worker does. Asset requests are free and unlimited on every plan
  // and never enter the wasm — run_worker_first keeps /ws and /health on the
  // relay script while the platform answers everything else.
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/health"],
  },
  "env": {
    "beta": {
      "name": "byspace-relay-go-beta",
      // The beta channel answers on the same hostname the TypeScript Worker used, so
      // the beta PWA and its relay share one origin exactly like production does.
      "routes": [{ "pattern": "app-beta.byspace.cc.cd", "custom_domain": true }],
      // Wrangler does not inherit top-level bindings or migrations into a named
      // environment; the beta Worker needs its own. Without these the deploy
      // succeeds and every socket answers 500 because RELAY is unbound.
      "durable_objects": {
        "bindings": [
          {
            "name": "RELAY",
            "class_name": "RelayRoom",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["RelayRoom"],
        },
      ],
      "assets": {
        "directory": "../../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/ws", "/health"],
      },
      // Redeclared rather than inherited, for the same reason as the bindings above: a
      // configuration key Wrangler does not carry into a named environment would leave the beta
      // Worker on full ingestion while the stable one is sampled.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.01,
      },
    },
  },
}
