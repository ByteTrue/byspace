{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "incremental": false,
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/overrides/*", "../packages/app/src/*"],
      "react-native": ["./src/shims/react-native.ts"],
      "expo-router": ["./src/shims/expo-router.tsx"],
      "lucide-react-native": ["./src/shims/lucide-react-native.ts"],
      "expo-constants": ["./src/shims/expo-constants.ts"],
      "expo-localization": ["./src/shims/expo-localization.ts"],
      "expo-asset": ["./src/shims/expo-asset.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
