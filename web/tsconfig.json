{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "incremental": false,
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/core/*"]
    }
  },
  "include": [
    "src",
    "e2e",
    "perf",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "playwright.profile.config.ts"
  ]
}
