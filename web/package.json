{
  "name": "@bytetrue/web",
  "version": "0.25.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../scripts/build-public-docs.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test --project=browser",
    "build:mermaid-runtime": "node ./src/core/components/markdown/fence/mermaid/build-runtime.mjs",
    "test:e2e:diff-performance": "cross-env BYSPACE_DIFF_PERF_E2E=1 playwright test --project=browser e2e/browser/diff-performance.spec.ts",
    "test:e2e:stream-smoothness": "cross-env BYSPACE_AGENT_STREAM_PERF_E2E=1 playwright test --project=browser e2e/browser/agent-stream-smoothness.spec.ts",
    "test:e2e:real": "cross-env E2E_FORK_BYSPACE_HOME_FROM=../.dev/byspace-home playwright test --project=real-provider",
    "test:e2e:ui": "playwright test --ui",
    "profile:side-pane": "playwright test --config playwright.profile.config.ts side-pane-performance.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@bytetrue/client": "*",
    "@bytetrue/highlight": "*",
    "@bytetrue/protocol": "*",
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@marijn/find-cluster-break": "^1.0.2",
    "@replit/codemirror-vim": "6.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-virtual": "^3.13.21",
    "@xterm/addon-clipboard": "0.3.0-beta.213",
    "@xterm/addon-fit": "0.12.0-beta.213",
    "@xterm/addon-image": "0.10.0-beta.213",
    "@xterm/addon-ligatures": "0.11.0-beta.213",
    "@xterm/addon-search": "0.17.0-beta.213",
    "@xterm/addon-unicode11": "0.10.0-beta.213",
    "@xterm/addon-web-links": "0.13.0-beta.213",
    "@xterm/addon-webgl": "0.20.0-beta.212",
    "@xterm/xterm": "6.1.0-beta.213",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "fast-deep-equal": "^3.1.3",
    "htmlparser2": "^12.0.0",
    "i18next": "^26.3.0",
    "lucide-react": "0.546.0",
    "markdown-it": "^10.0.0",
    "material-icon-theme": "^5.32.0",
    "mnemonic-id": "^3.2.7",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-resizable-panels": "^4.17.0",
    "react-router": "^7.18.5",
    "sonner": "^2.0.8",
    "tiny-invariant": "^1.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "yaml": "^2.8.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "*",
    "@types/node": "~22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@xterm/headless": "6.1.0-beta.213",
    "dotenv": "^17.2.3",
    "esbuild": "0.28.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^20.0.3",
    "mermaid": "^11.16.0",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.6",
    "ws": "^8.20.0"
  }
}
